{#
  The layout for pages built in more than one language (DECISIONS 0025):
  base.html.jinja with every string from the catalog through t(), and the
  page's own lang. English values match base.html.jinja. No hreflang yet:
  it waits until after the ~2026-11-25 read of the dated titles.
#}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if ga4_measurement_id %}
{% include "_ga4.html.jinja" +%}
{% endif %}
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if noindex %}
<meta name="robots" content="{{ robots }}">
{% endif %}
{% if canonical_url %}
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:url" content="{{ canonical_url }}">
{% endif %}
<link rel="stylesheet" href="{{ root }}assets/style.css">
<link rel="icon" href="{{ root }}assets/mark.svg" type="image/svg+xml">
<meta name="theme-color" content="#eeeff7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#141733" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:site_name" content="{{ site_name }}">
<meta name="twitter:card" content="summary">
{% if structured_data %}
<script type="application/ld+json">{{ structured_data|tojson }}</script>
{% endif %}
</head>
<body>
<a class="skip-link" href="#main">{{ t("chrome.skip") }}</a>
<header class="site-header">
  <div class="wrap">
    <p class="site-name"><a href="{{ root }}"><svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="5" y="2.5" width="22" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><rect x="5" y="2.5" width="22" height="5.5" rx="2" fill="currentColor"/><path d="M10 11.5h12M10 14.5h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16 17.5v7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M3 25.5c2.2-1.6 4.4-1.6 6.5 0s4.4 1.6 6.5 0 4.4-1.6 6.5 0 4.4 1.6 6.5 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M7 29.5c1.6-1 3.2-1 4.8 0s3.2 1 4.8 0 3.2-1 4.8 0 3 1 4 0" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".6"/></svg><span class="wordmark">{{ site_name }}</span></a> <span class="site-tagline">{{ t("chrome.tagline") }}</span></p>
    <nav aria-label="{{ t('nav.label') }}">
      <a href="{{ root }}">{{ t("nav.latest") }}</a>
      <a href="{{ root }}advisories/">{{ t("nav.advisories") }}</a>
      <a href="{{ root }}county/">{{ t("nav.county") }}</a>
      {% if "MO" in states_present %}<a href="{{ root }}state/mo/">{{ t("nav.missouri") }}</a>{% endif %}
      {% if ny_history %}<a href="{{ root }}state/ny/">{{ t("nav.ny_history") }}</a>{% endif %}
      <a href="{{ root }}dogs/">{{ t("nav.dogs") }}</a>
      <a href="{{ root }}about/">{{ t("nav.about") }}</a>
    </nav>
  </div>
</header>
<main id="main" class="wrap">
{% if breadcrumb %}
<nav aria-label="{{ t('nav.breadcrumb') }}" class="breadcrumb">
  <ol>
    {% for name, url in breadcrumb %}
    {% if loop.last %}
    <li><a href="{{ url }}" aria-current="page">{{ name }}</a></li>
    {% else %}
    <li><a href="{{ url }}">{{ name }}</a></li>
    {% endif %}
    {% endfor %}
  </ol>
</nav>
{% endif %}
{% if other_language_url %}
<p class="other-language"><a href="{{ other_language_url }}" lang="{{ other_lang }}">{{ t("chrome.other_language") }}</a></p>
{% endif %}
{% block content %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="wrap">
    {% for s in all_sources %}
    <p>{{ t("footer.attribution." ~ s.id) }}</p>
    {% endfor %}
    {% if ny_history %}
    <p>{{ t("footer.attribution.ny") }} <a href="{{ root }}state/ny/#source">{{ t("footer.ny_source") }}</a>.</p>
    {% endif %}
    <p id="not-medical-advice">{{ t("footer.not_medical_advice") }}</p>
    <p>{{ t("footer.independent", site_name=site_name) }}{% for s in all_sources if s.required_disclaimer %} <a href="{{ root }}about/#{{ s.id }}">{{ t("footer.disclaimer_link", state=t("state." ~ s.state)) }}</a>.{% endfor %}</p>
    <p>{{ t("footer.file", file_name=source_file.file_name, date=local_date(source_file.fetched_at[:10])) }} <a href="{{ source.official_map_url }}">{{ source.official_map_url }}</a></p>
    <p><a href="{{ source.dataset_url }}">{{ t("footer.dataset") }}</a> &middot; <a href="{{ root }}about/">{{ t("footer.about") }}</a> &middot; <a href="{{ root }}privacy/">{{ t("footer.privacy") }}</a> &middot; <a href="{{ root }}terms/">{{ t("footer.terms") }}</a> &middot; <a href="{{ root }}support/">{{ t("footer.support") }}</a></p>
    {% if ga4_measurement_id %}
    <p id="analytics-choice" hidden><button type="button" id="analytics-opt-out" class="link-button" hidden>{{ t("footer.analytics_opt_out") }}</button> <span id="analytics-status" role="status"></span></p>
    {% endif %}
  </div>
</footer>
</body>
</html>
