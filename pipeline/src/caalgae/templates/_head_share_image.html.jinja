{# The picture a link preview shows, the same on every page: the mark and
   the site's name, nothing about any water (docs/DESIGN.md). Its alt text
   is the site's name and no more. #}
<meta property="og:image" content="{{ share_image_url }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="{{ share_image_size[0] }}">
<meta property="og:image:height" content="{{ share_image_size[1] }}">
<meta property="og:image:alt" content="{{ site_name }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ share_image_url }}">
<meta name="twitter:image:alt" content="{{ site_name }}">
