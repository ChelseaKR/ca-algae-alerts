{% extends "base.html.jinja" %}
{% block content %}
<h1>{{ county }} County: lake and river algae advisories</h1>
<p class="lede">{{ waters|length }} waters in {{ county }} County appear in the state's harmful algal bloom records. Waters whose latest record is an advisory come first.</p>
<table>
  <caption class="visually-hidden">Waters in {{ county }} County and what the state's latest record says</caption>
  <thead><tr><th scope="col">Water</th><th scope="col">Latest record</th></tr></thead>
  <tbody>
  {% for w in waters %}
    <tr><td><a href="{{ root }}water/{{ w.id }}/">{{ w.name }}</a></td><td>{{ headline(w.status) }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endblock %}
