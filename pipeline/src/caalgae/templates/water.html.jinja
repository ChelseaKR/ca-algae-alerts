{% extends "base.html.jinja" %}
{% from "_macros.html.jinja" import status_box, satellite_box, required_disclaimer %}
{% block content %}
<h1>{{ water.name }}: toxic algae advisories</h1>
{% if outage %}
<div class="notice-unavailable" role="note">
  <p><strong>{{ outage_banner }}</strong> Check the <a href="{{ outage.map_url }}">{{ state_name }} state map</a> before you go.</p>
</div>

<h2 id="status">What the state's records say</h2>
<div class="status status-unavailable">
  <p class="status-line"><strong>{{ unavailable_status(state_name, outage.since) }}</strong></p>
  <p class="muted">The records on this page are history, not a current status. Check the state's map and any signs posted at the water.</p>
</div>
{% else %}
<p class="lede">{{ summary }}{% for name, slug in county_links %} See all <a href="{{ root }}county/{{ slug }}/">{{ name }} County waters</a>.{% endfor %}</p>

<h2 id="status">What the state's records say</h2>
{{ status_box(water.status, status_notes) }}
{% if guidance_for(water) %}
<p><strong>What this level asks:</strong> {{ guidance_for(water) }}</p>
{% endif %}
<p>Before you go, check the <a href="{{ water_source.official_map_url }}">state's official algae page</a> and any signs posted at the water.{% if app_store_url %} The <a href="{{ app_store_url }}">iPhone app</a> can alert you when {{ water.name }} gets a new advisory.{% endif %}</p>
{% endif %}

<p id="after-contact"><strong>After contact with the water:</strong> {{ human_advice }}</p>

{% if same_name_nearby %}
<h2 id="same-name">Matching names nearby</h2>
<p>The state's file also has {{ "this entry" if same_name_nearby|length == 1 else "these entries" }} with a name that matches {{ water.name }}, within {{ same_name_miles }} miles of it. {{ "It" if same_name_nearby|length == 1 else "They" }} may be the same water, listed under another county or spelling. Each entry has its own records:</p>
<ul>
{% for other in same_name_nearby %}
  <li><a href="{{ root }}water/{{ other.id }}/">{{ other.name }}</a>, {{ other.place }}: {{ other.headline }}</li>
{% endfor %}
</ul>
{% endif %}

{% if trout_truck %}
<h2 id="trout-plantings">Trout plantings at {{ water.name }}</h2>
<p>The California Department of Fish and Wildlife lists {{ trout_truck.name }} in its trout planting schedule. Trout Truck, another free site by Chelsea Kelly-Reif, who makes Lake Notice, shows its planting weeks and history: <a href="{{ trout_truck.url }}">{{ trout_truck.name }} trout planting schedule on Trout Truck</a>.{% if trout_truck.kind == "stream" %} The department plants along the stream. The algae records on this page are at the spots the state names, which may be on a different stretch.{% endif %}</p>
{% endif %}

<h2 id="dogs">Dogs at {{ water.name }}</h2>
<p>{{ unavailable_dog_answer(water.name, state_name) if outage else dog_answer(water.name, water.status) }}</p>
<p class="muted"><a href="{{ root }}dogs/">More on dogs and toxic algae</a>.</p>

{% if water.satellite and satellite_source %}
{{ satellite_box(water.satellite, satellite_explainer, satellite_source) }}
{% endif %}

<h2 id="sites">Reported spots</h2>
<p>The state records each report at a spot, such as a beach or a boat ramp. Each spot's latest deciding record:</p>
<table>
  <caption class="visually-hidden">Each reported spot at {{ water.name }} and its latest status</caption>
  <thead><tr><th scope="col">Spot</th><th scope="col">Status</th></tr></thead>
  <tbody>
  {% for site in water.sites %}
    <tr>
      <td>{{ site.landmark or "Spot not described" }}</td>
      <td>{{ "No current status" if outage else headline(site.status) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2 id="history">{{ unavailable_history_heading(outage.since) if outage else "Advisory history" }}</h2>
{% if water.state == "CA" %}
<p>Every advisory record the state has published for {{ water.name }}, newest first. "None" is the state's record that no advisory was recommended on that date. "NA" records do not change a status.</p>
{% else %}
<p>Every case the state has published for {{ water.name }}, newest first. Each case carries its current status code; the label beside it is this site's reading of the code.</p>
{% endif %}
<table>
  <caption class="visually-hidden">Advisory records for {{ water.name }}, newest first</caption>
  <thead><tr><th scope="col">Date</th><th scope="col">Spot</th><th scope="col">State's level</th><th scope="col">Notes</th></tr></thead>
  <tbody>
  {% for r in water.records %}
    <tr>
      <td>{{ r.date|date }}</td>
      <td>{{ sites[r.site].landmark or "Spot not described" }}</td>
      <td>{{ r.level or "Blank in the state's file" }}</td>
      <td>{% if r.end_date %}End date recorded: {{ r.end_date|date }}. {% endif %}{% if r.removed_from_source %}Withdrawn from the state's file on {{ r.removed_from_source|date }}. {% endif %}{{ r.detail }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2 id="source">Source</h2>
<p>{{ water_source.attribution }} <a href="{{ water_source.dataset_url }}">The state's data</a>. {{ water_source.lift_explanation }}</p>
{{ required_disclaimer(water_source) }}
{% endblock %}
