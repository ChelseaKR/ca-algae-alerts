r recarr = When(Includes(usearr, 'rec'), Split($feature.WBRUse, \",\"), '')\r\nvar reccount = Count(recarr)\r\nvar reclist = '.'\r\nvar rec1 = When(reccount >0, When(Includes(recarr, 'swim_bch'), concatenate([reclist, 'Swimming Area or Beach - Designated'], ' / '), reclist), '')\r\nvar rec2 = When(reccount >0, When(Includes(recarr, 'swim'), concatenate([rec1, 'Swimming Area or Beach'], ' / '), rec1), '')\r\nvar rec3 = When(reccount >0, When(Includes(recarr, 'boat'), concatenate([rec2, 'Boating'], ' / '), rec2), '')\r\nvar rec4 = When(reccount >0, When(Includes(recarr, 'ski'), concatenate([rec3, 'Personal Watercraft or Water Skiing or Wakeboarding)'], ' / '), (rec3 + \" / Not Specified)\")), '')\r\nvar rectxt = Replace(rec4, '. / ', '')\r\nvar WBUList = '.'\r\nvar WBU1 = When(Includes(usearr, 'wtr_spply'), concatenate([WBUList, 'Drinking Water Supply'], ' / '), WBUList)\r\nvar WBU2 = When(Includes(usearr, 'hunt'), concatenate([WBU1, 'Hunting & Fishing'], ' / '), WBU1)\r\nvar WBU3 = When(Includes(usearr, 'irrigation'), concatenate([WBU2, 'Agricultural Irrigation'], ' / '), WBU2)\r\nvar WBU4 = When(Includes(usearr, 'livestock'), concatenate([WBU3, 'Livestock Watering'], ' / '), WBU3)\r\nvar WBU5 = When(Includes(usearr, 'aquacult'), concatenate([WBU4, 'Aquaculture'], ' / '), WBU4)\r\nvar WBU6 = When(Includes(usearr, 'reten_basn'), concatenate([WBU5, 'Stormwater Retention or Flood Control'], ' / '), WBU5)\r\nvar WBU7 = When(Includes(usearr, 'rec'), concatenate([WBU6, 'Recreation ('], ' / '), WBU6)\r\nvar WBU8 = When(reccount >0, concatenate([WBU7, rectxt], ''), (WBU7 + \"Not Specified\"))\r\nvar WBUse = Replace(WBU8, '. / ', '')\r\nvar WBUse1 = Replace(WBUse, '.', '')\r\nReturn WBUse1","valueType":"STRING","useDataSources":[{"dataSourceId":"dataSource_3-HAB_SUBMIT_POINTS_5792","mainDataSourceId":"dataSource_3-HAB_SUBMIT_POINTS_5792","rootDataSourceId":"dataSource_3","fields":["WBUse","WBRUse"]}]}],"arcadeFieldName":"exbArcadeField7_1785271033973"},"exbArcadeField8_178527